# Audio/image/video media files are deliberately kept out of git (see
# README: "What's actually portable here" / distribution model). They live
# locally, and are distributed separately via archive.org (see
# tools/publish_to_archive_org.py).
bands/**/*.mp3
bands/**/*.flac
bands/**/*.wav
bands/**/*.ogg
bands/**/*.m4a
bands/**/*.jpg
bands/**/*.jpeg
bands/**/*.png
bands/**/*.webp
bands/**/*.mp4
bands/**/*.mov
bands/**/*.mkv
bands/**/*.flv

# Generated static site output (ADR-0001) - a build artifact, not source.
webapp/dist/
