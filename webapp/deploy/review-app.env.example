# Copy to /opt/daugavpils-fans/review-app.env on the server, fill in real
# values, chmod 600 - never committed (see GitHub issue #14's secrets
# list and webapp/deploy/README.md).

SECRET_KEY=
DATABASE_PATH=/data/review.db
ARCHIVE_CHECKOUT_PATH=/site/current-checkout
MAINTAINER_EMAIL=

SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=svalevka/daugavpils.fans

# Also set as a GitHub repo secret of the same name (Settings > Secrets
# and variables > Actions) - .github/workflows/apply-proposal.yml reads
# it from there to authenticate its callback to this app. The value here
# and there must match exactly.
REVIEW_APP_CALLBACK_KEY=

RATE_LIMIT_PER_IP_PER_HOUR=5
