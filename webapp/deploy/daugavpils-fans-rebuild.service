[Unit]
Description=Rebuild review-app and reload containers on trigger (see rebuild-containers.sh, GitHub issue #83)
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/daugavpils-fans
Environment=BASE_DIR=/opt/daugavpils-fans
Environment=DOCKER_COMPOSE_FILE=/opt/daugavpils-fans/docker-compose.yml
Environment=REBUILD_MARKER_FILE=/opt/daugavpils-fans/.rebuild-needed
ExecStart=/opt/daugavpils-fans/rebuild-containers.sh
