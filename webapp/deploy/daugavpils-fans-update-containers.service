[Unit]
Description=Automated container security updates (see update-containers.sh, GitHub issue #82)
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
User=root
Environment=BASE_DIR=/opt/daugavpils-fans
Environment=DOCKER_COMPOSE_FILE=/opt/daugavpils-fans/docker-compose.yml
ExecStart=/opt/daugavpils-fans/update-containers.sh
